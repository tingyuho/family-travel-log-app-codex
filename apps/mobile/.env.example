# Local development only. Production values belong in the EAS production environment.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:8000
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
EXPO_IOS_BUNDLE_IDENTIFIER=com.yourname.familytravellog
EXPO_ANDROID_PACKAGE=com.yourname.familytravellog
EXPO_PUBLIC_FEATURE_MAP_ADVANCED_LAYERS=true
EXPO_PUBLIC_FEATURE_MAP_CLUSTERS=true
EXPO_PUBLIC_FEATURE_MAP_HEATMAP=false
EXPO_PUBLIC_FEATURE_CALENDAR_ICS_SHARE=true
EXPO_PUBLIC_FEATURE_PROFILE_RESET_IN_APP=true
