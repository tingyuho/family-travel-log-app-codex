# Reference only: EAS production builds load this value from the EAS production environment.
# Do not copy a development LAN address into production.
EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.example

# Optional native map configuration for the production EAS environment.
GOOGLE_MAPS_API_KEY=your-production-google-maps-api-key
EXPO_IOS_BUNDLE_IDENTIFIER=com.yourname.familytravellog
