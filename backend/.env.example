# Copy this file to backend/.env and fill in your own private values.
# backend/.env is ignored by git.

# Local development defaults. Production must set APP_ENV=production and use
# the values shown in backend/.env.production.example.
APP_ENV=development
DATABASE_URL=
FRONTEND_ORIGINS=http://127.0.0.1:5173
SESSION_TTL_DAYS=30

# Gmail personal account example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# Optional admin-only reset override. Disabled by default and not shown in normal app UI.
# Enable only for controlled development/admin workflows.
PASSWORD_RESET_ADMIN_KEY_ENABLED=false
PASSWORD_RESET_KEY=change-this-to-a-private-reset-key

# Optional: reset code lifetime in minutes.
PASSWORD_RESET_CODE_TTL_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=8
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=4

# Optional place search proxy settings used by web and mobile route search.
# google_places uses the Google Places API Text Search endpoint.
GEOCODER_PROVIDER=google_places
GOOGLE_PLACES_API_KEY=your-server-side-google-places-key
GEOCODER_CACHE_TTL_SECONDS=900
GEOCODER_RATE_LIMIT_PER_MINUTE=30

# Optional fallback provider for local development:
# GEOCODER_PROVIDER=nominatim
# GEOCODER_USER_AGENT=FamilyTravelLog/2.0 (+contact@example.com)
