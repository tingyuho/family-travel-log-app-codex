# Set these values in the backend host's production environment. Do not commit real secrets.
APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
FRONTEND_ORIGINS=https://travel.your-domain.example
SESSION_TTL_DAYS=30

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-production-mailbox@example.com
SMTP_PASSWORD=your-production-smtp-password
SMTP_FROM_EMAIL=your-production-mailbox@example.com
SMTP_USE_TLS=true

PASSWORD_RESET_ADMIN_KEY_ENABLED=false
PASSWORD_RESET_CODE_TTL_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=8
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=4

GEOCODER_PROVIDER=google_places
GOOGLE_PLACES_API_KEY=your-server-side-google-places-key
GEOCODER_CACHE_TTL_SECONDS=900
GEOCODER_RATE_LIMIT_PER_MINUTE=30
